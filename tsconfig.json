{
    "compilerOptions": {
        "target":"ES6",
        "module":"esnext",
        "lib":["DOM","ES6"],
        "jsx": "react-jsx",
        "outDir": "./dist",
        "rootDir": ".",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "allowSyntheticDefaultImports": true
    },
    "include": ["client/**/*","server"],
    "exclude": ["node_modules"]
}